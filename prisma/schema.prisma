generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

enum AuthThrottleScope {
  LOGIN_EMAIL
  LOGIN_NETWORK
  SETUP_NETWORK
  RESET_EMAIL
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
  PENDING_DOUBLE_OPT_IN
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PAUSED
  COMPLETED
}

enum ContactImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  BLOCKED
}

enum QueueJobType {
  SCHEDULED_CAMPAIGN
}

enum QueueJobStatus {
  QUEUED
  PROCESSING
  CANCELLED
  COMPLETED
  FAILED
}

enum MessageApplicationStatus {
  ACCEPTED
  SCHEDULED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  AMBIGUOUS
}

enum MessageTransport {
  DUMMY
  TWILIO
}

enum MessageAttemptStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  AMBIGUOUS
  RESOLVED_NOT_SENT
}

enum A2pRegistrationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum UsageEventType {
  CONTACT_IMPORTED
  MESSAGE_INBOUND
  CAMPAIGN_SCHEDULED
  AI_REQUEST
}

enum BillingAccountStatus {
  DEMO
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ProviderPhoneNumberStatus {
  DEMO
  CONFIGURED
  DISABLED
  VERIFIED
}

enum ProviderAccountStatus {
  VERIFIED
  DEGRADED
  REVOKED
}

enum ProviderMessagingServiceStatus {
  VERIFIED
  DISABLED
}

enum CustomerWebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum CustomerWebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  CANCELED
}

model Organization {
  id                              String                           @id @default(cuid())
  name                            String
  slug                            String                           @unique
  clerkOrgId                      String?                          @unique
  demoMode                        Boolean                          @default(true)
  timezone                        String                           @default("America/Los_Angeles")
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  memberships                     Membership[]
  contacts                        Contact[]
  tags                            Tag[]
  contactLists                    ContactList[]
  segments                        Segment[]
  contactImports                  ContactImport[]
  templates                       MessageTemplate[]
  campaigns                       Campaign[]
  queueJobs                       QueueJob[]
  conversations                   Conversation[]
  messages                        Message[]
  messageAttempts                 MessageAttempt[]
  internalNotes                   InternalNote[]
  complianceProfile               ComplianceProfile?
  usageEvents                     UsageEvent[]
  billingAccount                  BillingAccount?
  webhookEvents                   WebhookEvent[]
  providerAccounts                ProviderAccount[]
  providerCredentialSecrets       ProviderCredentialSecret[]
  providerMessagingServices       ProviderMessagingService[]
  providerPhoneNumbers            ProviderPhoneNumber[]
  providerCredentials             ProviderCredential[]
  providerCredentialRotations     ProviderCredentialRotation[]
  liveReadinessAuditEvents        LiveReadinessAuditEvent[]
  authSessions                    AuthSession[]
  authTokens                      AuthToken[]
  apiCredentials                  ApiCredential[]
  apiIdempotencyRecords           ApiIdempotencyRecord[]
  integrationAuditEvents          IntegrationAuditEvent[]
  customerWebhookEndpoints        CustomerWebhookEndpoint[]
  customerWebhookSubscriptions    CustomerWebhookSubscription[]
  customerWebhookSigningSecrets   CustomerWebhookSigningSecret[]
  customerWebhookEvents           CustomerWebhookEvent[]
  customerWebhookDeliveries       CustomerWebhookDelivery[]
  customerWebhookDeliveryAttempts CustomerWebhookDeliveryAttempt[]
}

model AppUser {
  id                    String           @id @default(cuid())
  /// Legacy optional external identity subject. Built-in users do not require Clerk.
  clerkUserId           String?          @unique
  email                 String           @unique
  normalizedEmail       String           @unique
  displayName           String?
  emailVerifiedAt       DateTime?
  disabledAt            DateTime?
  authVersion           Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  memberships           Membership[]
  assignedConversations Conversation[]   @relation("ConversationAssignee")
  internalNotes         InternalNote[]
  localCredential       LocalCredential?
  authSessions          AuthSession[]
  authTokens            AuthToken[]      @relation("AuthTokenSubject")
  issuedAuthTokens      AuthToken[]      @relation("AuthTokenIssuer")

  @@index([disabledAt])
}

model LocalCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
}

model AuthSession {
  id                String       @id @default(cuid())
  tokenHash         String       @unique
  userId            String
  orgId             String
  authVersion       Int
  createdAt         DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  user              AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membership        Membership   @relation("AuthSessionMembership", fields: [orgId, userId], references: [orgId, userId], onDelete: Cascade)

  @@index([orgId, userId])
  @@index([userId, revokedAt])
  @@index([orgId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model AuthToken {
  id             String          @id @default(cuid())
  type           AuthTokenType
  tokenHash      String          @unique
  userId         String?
  orgId          String?
  email          String?
  role           MembershipRole?
  issuedByUserId String?
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())
  user           AppUser?        @relation("AuthTokenSubject", fields: [userId], references: [id], onDelete: Cascade)
  org            Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  issuedBy       AppUser?        @relation("AuthTokenIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@index([type, expiresAt])
  @@index([userId, type])
  @@index([orgId, type])
  @@index([orgId, userId])
  @@index([orgId, issuedByUserId])
  @@index([issuedByUserId])
}

model AuthThrottle {
  id              String            @id @default(cuid())
  scope           AuthThrottleScope
  keyHash         String
  windowStartedAt DateTime          @default(now())
  attempts        Int               @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime          @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
}

model Membership {
  id                        String           @id @default(cuid())
  orgId                     String
  userId                    String
  role                      MembershipRole   @default(MEMBER)
  status                    MembershipStatus @default(ACTIVE)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  org                       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                      AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSessions              AuthSession[]    @relation("AuthSessionMembership")
  assignedConversations     Conversation[]   @relation("ConversationAssigneeMembership")
  reconciledMessageAttempts MessageAttempt[] @relation("MessageAttemptReconciler")

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model Contact {
  id                 String              @id @default(cuid())
  orgId              String
  phone              String
  email              String?
  firstName          String?
  lastName           String?
  displayName        String?
  consentStatus      ConsentStatus       @default(UNKNOWN)
  optInSource        String?
  optInAt            DateTime?
  optedOutAt         DateTime?
  /// Part of the all-or-none, write-once consent evidence bundle enforced by database migrations.
  consentCapturedAt  DateTime?
  /// Part of the all-or-none, write-once consent evidence bundle enforced by database migrations.
  consentMethod      String?
  /// Part of the all-or-none, write-once consent evidence bundle enforced by database migrations.
  consentDisclosure  String?
  source             String?
  notes              String?
  leadScore          Int?
  leadStage          String?
  leadQualifiedAt    DateTime?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tagLinks           ContactTag[]
  listLinks          ContactListMember[]
  campaignRecipients CampaignRecipient[]
  conversations      Conversation[]
  messages           Message[]

  @@unique([orgId, id])
  @@unique([orgId, phone])
  @@index([orgId])
  @@index([orgId, consentStatus])
  @@index([orgId, archivedAt])
}

model Tag {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  color     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([orgId, id])
  @@unique([orgId, name])
  @@index([orgId])
}

model ContactTag {
  id        String   @id @default(cuid())
  orgId     String
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)
  tag       Tag      @relation(fields: [orgId, tagId], references: [orgId, id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([orgId])
  @@index([orgId, contactId])
  @@index([orgId, tagId])
  @@index([tagId])
}

model ContactList {
  id          String              @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     ContactListMember[]

  @@unique([orgId, id])
  @@unique([orgId, name])
  @@index([orgId])
}

model ContactListMember {
  id        String      @id @default(cuid())
  orgId     String
  listId    String
  contactId String
  createdAt DateTime    @default(now())
  list      ContactList @relation(fields: [orgId, listId], references: [orgId, id], onDelete: Cascade)
  contact   Contact     @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([orgId])
  @@index([orgId, listId])
  @@index([orgId, contactId])
  @@index([contactId])
}

model Segment {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  description String?
  definition  Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

model MessageTemplate {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  body      String
  variables Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([orgId, id])
  @@unique([orgId, name])
  @@index([orgId])
}

model ContactImport {
  id           String              @id @default(cuid())
  orgId        String
  filename     String?
  status       ContactImportStatus @default(PENDING)
  totalRows    Int                 @default(0)
  importedRows Int                 @default(0)
  failedRows   Int                 @default(0)
  errors       Json?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Campaign {
  id          String              @id @default(cuid())
  orgId       String
  templateId  String?
  name        String
  status      CampaignStatus      @default(DRAFT)
  body        String
  scheduledAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// PostgreSQL migration SQL uses column-specific SET NULL so orgId remains non-null.
  template    MessageTemplate?    @relation(fields: [orgId, templateId], references: [orgId, id], onDelete: SetNull)
  recipients  CampaignRecipient[]
  queueJobs   QueueJob[]
  messages    Message[]

  @@unique([orgId, id])
  @@index([orgId])
  @@index([orgId, templateId])
  @@index([orgId, status])
}

model CampaignRecipient {
  id          String                  @id @default(cuid())
  orgId       String
  campaignId  String
  contactId   String
  status      CampaignRecipientStatus @default(PENDING)
  blockReason String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  campaign    Campaign                @relation(fields: [orgId, campaignId], references: [orgId, id], onDelete: Cascade)
  contact     Contact                 @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([orgId])
  @@index([orgId, campaignId])
  @@index([orgId, contactId])
  @@index([contactId])
}

model Conversation {
  id                 String             @id @default(cuid())
  orgId              String
  contactId          String?
  assignedToUserId   String?
  status             ConversationStatus @default(OPEN)
  lastMessageAt      DateTime?
  assignedAt         DateTime?
  resolvedAt         DateTime?
  sentiment          String?
  category           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  org                Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// PostgreSQL migration SQL uses column-specific SET NULL so orgId remains non-null.
  contact            Contact?           @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: SetNull)
  assignedTo         AppUser?           @relation("ConversationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  /// PostgreSQL migration SQL uses column-specific SET NULL so orgId remains non-null.
  assignedMembership Membership?        @relation("ConversationAssigneeMembership", fields: [orgId, assignedToUserId], references: [orgId, userId], onDelete: SetNull)
  messages           Message[]
  internalNotes      InternalNote[]

  @@unique([orgId, id])
  @@index([orgId])
  @@index([orgId, contactId])
  @@index([orgId, assignedToUserId])
  @@index([orgId, status])
  @@index([contactId])
  @@index([assignedToUserId])
}

model QueueJob {
  id                  String         @id @default(cuid())
  orgId               String
  campaignId          String?
  type                QueueJobType
  status              QueueJobStatus @default(QUEUED)
  idempotencyKey      String
  payload             Json
  runAt               DateTime
  processingToken     String?
  processingExpiresAt DateTime?
  /// Monotonic durable generation used to distinguish reopened BullMQ mirror jobs.
  generation          Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  org                 Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign            Campaign?      @relation(fields: [orgId, campaignId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([orgId, campaignId])
  @@index([orgId, status])
  @@index([status, processingExpiresAt])
  @@index([campaignId])
}

model Message {
  id                 String                   @id @default(cuid())
  orgId              String
  contactId          String?
  conversationId     String?
  campaignId         String?
  direction          String
  body               String
  applicationStatus  MessageApplicationStatus @default(ACCEPTED)
  transport          MessageTransport         @default(DUMMY)
  destination        String?
  mediaUrls          String[]                 @default([])
  requestFingerprint String?
  providerMessageId  String?
  providerStatus     String?
  providerErrorCode  String?
  deliveredAt        DateTime?
  failedAt           DateTime?
  acceptedAt         DateTime                 @default(now())
  scheduledAt        DateTime?
  sentAt             DateTime?
  cancelledAt        DateTime?
  ambiguousAt        DateTime?
  attemptCount       Int                      @default(0)
  idempotencyKey     String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  org                Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// PostgreSQL migration SQL uses column-specific SET NULL so orgId remains non-null.
  contact            Contact?                 @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: SetNull)
  /// PostgreSQL migration SQL uses column-specific SET NULL so orgId remains non-null.
  conversation       Conversation?            @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: SetNull)
  /// PostgreSQL migration SQL uses column-specific SET NULL so orgId remains non-null.
  campaign           Campaign?                @relation(fields: [orgId, campaignId], references: [orgId, id], onDelete: SetNull)
  attempts           MessageAttempt[]

  @@unique([orgId, id])
  @@unique([orgId, idempotencyKey])
  @@unique([orgId, providerMessageId])
  @@index([orgId])
  @@index([orgId, contactId])
  @@index([orgId, conversationId])
  @@index([orgId, campaignId])
  @@index([orgId, applicationStatus])
  @@index([orgId, applicationStatus, scheduledAt])
  @@index([conversationId])
  @@index([contactId])
  @@index([providerMessageId])
}

model MessageAttempt {
  id                         String                    @id @default(cuid())
  orgId                      String
  messageId                  String
  attemptNumber              Int
  retryOfAttemptId           String?
  status                     MessageAttemptStatus      @default(QUEUED)
  transport                  MessageTransport
  dueAt                      DateTime                  @default(now())
  processingToken            String?
  processingExpiresAt        DateTime?
  claimedAt                  DateTime?
  providerCallStartedAt      DateTime?
  providerAccountId          String?
  providerCredentialSecretId String?
  providerCredentialVersion  Int?
  providerPhoneNumberId      String?
  destination                String
  body                       String
  mediaUrls                  String[]                  @default([])
  requestFingerprint         String
  callbackCorrelationId      String                    @unique
  providerMessageId          String?
  providerStatus             String?
  providerErrorCode          String?
  errorCode                  String?
  disposition                String?
  completedAt                DateTime?
  reconciledAt               DateTime?
  reconciledByUserId         String?
  reconciliationNote         String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  org                        Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  message                    Message                   @relation(fields: [orgId, messageId], references: [orgId, id], onDelete: Restrict)
  retryOf                    MessageAttempt?           @relation("MessageAttemptRetry", fields: [orgId, messageId, retryOfAttemptId], references: [orgId, messageId, id], onDelete: Restrict)
  retries                    MessageAttempt[]          @relation("MessageAttemptRetry")
  providerAccount            ProviderAccount?          @relation(fields: [orgId, providerAccountId], references: [orgId, id], onDelete: Restrict)
  providerCredentialSecret   ProviderCredentialSecret? @relation(fields: [orgId, providerAccountId, providerCredentialSecretId, providerCredentialVersion], references: [orgId, providerAccountId, id, version], onDelete: Restrict)
  providerPhoneNumber        ProviderPhoneNumber?      @relation(fields: [orgId, providerAccountId, providerPhoneNumberId], references: [orgId, providerAccountId, id], onDelete: Restrict)
  reconciledByMembership     Membership?               @relation("MessageAttemptReconciler", fields: [orgId, reconciledByUserId], references: [orgId, userId], onDelete: Restrict)

  @@unique([orgId, id])
  @@unique([orgId, messageId, id])
  @@unique([orgId, messageId, attemptNumber])
  @@unique([orgId, providerAccountId, providerMessageId])
  @@index([orgId])
  @@index([orgId, status, dueAt, processingExpiresAt])
  @@index([orgId, messageId, createdAt])
  @@index([orgId, providerAccountId])
  @@index([orgId, providerPhoneNumberId])
  @@index([orgId, reconciledByUserId])
  @@index([providerMessageId])
}

model InternalNote {
  id             String       @id @default(cuid())
  orgId          String
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade)
  author         AppUser      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, conversationId])
  @@index([orgId, authorUserId])
  @@index([conversationId])
  @@index([authorUserId])
}

model ComplianceProfile {
  id                    String                @id @default(cuid())
  orgId                 String                @unique
  businessName          String?
  messagingUseCase      String?
  optInDescription      String?
  privacyPolicyUrl      String?
  termsOfServiceUrl     String?
  a2pRegistrationStatus A2pRegistrationStatus @default(NOT_STARTED)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  org                   Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model UsageEvent {
  id        String         @id @default(cuid())
  orgId     String
  type      UsageEventType
  quantity  Int            @default(1)
  metadata  Json?
  createdAt DateTime       @default(now())
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, type])
  @@index([createdAt])
}

model BillingAccount {
  id                   String               @id @default(cuid())
  orgId                String               @unique
  status               BillingAccountStatus @default(DEMO)
  liveBillingEnabled   Boolean              @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  org                  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
}

model ProviderAccount {
  id                     String                     @id @default(cuid())
  orgId                  String
  provider               String
  externalAccountId      String
  externalAccountIdHash  String                     @unique
  externalAccountIdLast4 String
  status                 ProviderAccountStatus
  isDefault              Boolean                    @default(false)
  accountStatus          String?
  accountType            String?
  verifiedAt             DateTime
  lastCheckedAt          DateTime
  revokedAt              DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  org                    Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  credentialSecrets      ProviderCredentialSecret[]
  messagingServices      ProviderMessagingService[]
  phoneNumbers           ProviderPhoneNumber[]
  messageAttempts        MessageAttempt[]

  @@unique([orgId, id])
  @@unique([orgId, id, provider])
  @@unique([provider, externalAccountId])
  @@index([orgId])
  @@index([orgId, provider, status])
}

model ProviderCredentialSecret {
  id                String           @id @default(cuid())
  orgId             String
  providerAccountId String
  version           Int
  envelopeVersion   Int              @default(1)
  algorithm         String           @default("aes-256-gcm")
  keyVersion        Int
  iv                String
  ciphertext        String
  authTag           String
  fingerprint       String
  activeFrom        DateTime         @default(now())
  retiredAt         DateTime?
  createdAt         DateTime         @default(now())
  org               Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  providerAccount   ProviderAccount  @relation(fields: [orgId, providerAccountId], references: [orgId, id], onDelete: Restrict)
  messageAttempts   MessageAttempt[]

  @@unique([orgId, id])
  @@unique([orgId, providerAccountId, id, version])
  @@unique([providerAccountId, version])
  @@index([orgId])
  @@index([orgId, providerAccountId])
  @@index([providerAccountId, retiredAt])
}

model ProviderMessagingService {
  id                     String                         @id @default(cuid())
  orgId                  String
  providerAccountId      String
  provider               String
  externalServiceId      String
  externalServiceIdHash  String                         @unique
  externalServiceIdLast4 String
  status                 ProviderMessagingServiceStatus
  isDefault              Boolean                        @default(false)
  capabilities           Json
  verifiedAt             DateTime
  lastCheckedAt          DateTime
  disabledAt             DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  org                    Organization                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  providerAccount        ProviderAccount                @relation(fields: [orgId, providerAccountId, provider], references: [orgId, id, provider], onDelete: Restrict)
  phoneNumbers           ProviderPhoneNumber[]

  @@unique([orgId, id])
  @@unique([orgId, providerAccountId, provider, id])
  @@unique([provider, externalServiceId])
  @@index([orgId])
  @@index([orgId, providerAccountId, status])
}

model ProviderPhoneNumber {
  id                         String                    @id @default(cuid())
  orgId                      String
  phoneNumber                String
  phoneNumberHash            String?
  label                      String?
  provider                   String                    @default("dummy")
  providerAccountId          String?
  providerMessagingServiceId String?
  externalNumberId           String?
  externalNumberIdLast4      String?
  status                     ProviderPhoneNumberStatus @default(DEMO)
  capabilities               Json
  /// At most one true row per org; enforced by a partial unique index in migration SQL.
  isDefault                  Boolean                   @default(false)
  verifiedAt                 DateTime?
  lastCheckedAt              DateTime?
  disabledAt                 DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  org                        Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  providerAccount            ProviderAccount?          @relation(fields: [orgId, providerAccountId, provider], references: [orgId, id, provider], onDelete: Restrict)
  providerMessagingService   ProviderMessagingService? @relation(fields: [orgId, providerAccountId, provider, providerMessagingServiceId], references: [orgId, providerAccountId, provider, id], onDelete: Restrict)
  messageAttempts            MessageAttempt[]

  @@unique([orgId, id])
  @@unique([orgId, providerAccountId, id])
  @@unique([orgId, phoneNumber])
  @@unique([provider, externalNumberId])
  @@index([orgId])
  @@index([orgId, isDefault])
  @@index([orgId, provider])
  @@index([orgId, providerAccountId])
  @@index([orgId, providerMessagingServiceId])
  @@index([orgId, status])
}

model ProviderCredential {
  id                   String       @id @default(cuid())
  orgId                String
  provider             String
  accountSidRedacted   String?
  accountSidLast4      String?
  authTokenFingerprint String?
  authTokenConfigured  Boolean      @default(false)
  fromNumberRedacted   String?
  fromNumberLast4      String?
  source               String       @default("local_metadata")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@index([orgId])
  @@index([orgId, provider])
}

model ProviderCredentialRotation {
  id                          String       @id @default(cuid())
  orgId                       String
  provider                    String
  providerCredentialId        String?
  action                      String
  actorUserId                 String?
  accountSidRedacted          String?
  accountSidLast4             String?
  fromNumberRedacted          String?
  fromNumberLast4             String?
  authTokenConfigured         Boolean      @default(false)
  previousAccountSidLast4     String?
  previousFromNumberLast4     String?
  previousAuthTokenConfigured Boolean      @default(false)
  source                      String       @default("local_metadata")
  createdAt                   DateTime     @default(now())
  org                         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, provider])
  @@index([orgId, providerCredentialId])
  @@index([orgId, actorUserId])
  @@index([createdAt])
}

model LiveReadinessAuditEvent {
  id          String       @id @default(cuid())
  orgId       String
  actorUserId String?
  action      String
  subjectType String
  subjectId   String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, actorUserId])
  @@index([orgId, subjectType, subjectId])
  @@index([orgId, action])
  @@index([createdAt])
}

model WebhookEvent {
  id             String       @id @default(cuid())
  orgId          String
  provider       String
  eventType      String
  idempotencyKey String
  rawPayload     Json
  receivedAt     DateTime     @default(now())
  processedAt    DateTime?
  claimToken     String?
  claimExpiresAt DateTime?
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([orgId, provider, eventType])
  @@index([orgId, processedAt, claimExpiresAt])
  @@index([receivedAt])
}

model ApiCredential {
  id                  String                  @id @default(cuid())
  orgId               String
  name                String
  prefix              String                  @unique
  secretHash          String                  @unique
  scopes              String[]
  rateLimitPerMinute  Int                     @default(60)
  rateWindowStartedAt DateTime?
  rateRequestCount    Int                     @default(0)
  expiresAt           DateTime?
  lastUsedAt          DateTime?
  lastUsedIpHash      String?
  revokedAt           DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  org                 Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  idempotencyRecords  ApiIdempotencyRecord[]
  auditEvents         IntegrationAuditEvent[]

  @@unique([orgId, id])
  @@index([orgId])
  @@index([orgId, revokedAt, expiresAt])
}

model ApiIdempotencyRecord {
  id              String        @id @default(cuid())
  orgId           String
  credentialId    String
  key             String
  method          String
  canonicalRoute  String
  requestHash     String
  responseStatus  Int
  responseBody    Json
  responseHeaders Json
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  credential      ApiCredential @relation(fields: [orgId, credentialId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, id])
  @@unique([orgId, credentialId, key])
  @@index([orgId])
  @@index([orgId, expiresAt])
  @@index([credentialId])
}

model IntegrationAuditEvent {
  id              String         @id @default(cuid())
  orgId           String
  actorUserId     String?
  apiCredentialId String?
  action          String
  subjectType     String
  subjectId       String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  org             Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiCredential   ApiCredential? @relation(fields: [orgId, apiCredentialId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, id])
  @@index([orgId])
  @@index([orgId, apiCredentialId])
  @@index([orgId, actorUserId])
  @@index([orgId, action, createdAt])
  @@index([orgId, subjectType, subjectId])
}

model CustomerWebhookEndpoint {
  id                  String                        @id @default(cuid())
  orgId               String
  name                String
  canonicalUrl        String
  status              CustomerWebhookEndpointStatus @default(ACTIVE)
  consecutiveFailures Int                           @default(0)
  lastFailureAt       DateTime?
  lastSuccessAt       DateTime?
  disabledAt          DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  org                 Organization                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptions       CustomerWebhookSubscription[]

  @@unique([orgId, id])
  @@unique([orgId, canonicalUrl])
  @@index([orgId])
  @@index([orgId, status])
}

model CustomerWebhookSubscription {
  id             String                         @id @default(cuid())
  orgId          String
  endpointId     String
  eventTypes     String[]
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  org            Organization                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoint       CustomerWebhookEndpoint        @relation(fields: [orgId, endpointId], references: [orgId, id], onDelete: Restrict)
  signingSecrets CustomerWebhookSigningSecret[]
  deliveries     CustomerWebhookDelivery[]

  @@unique([orgId, id])
  @@unique([orgId, endpointId])
  @@unique([orgId, endpointId, id])
  @@index([orgId])
  @@index([endpointId])
}

model CustomerWebhookSigningSecret {
  id              String                      @id @default(cuid())
  orgId           String
  subscriptionId  String
  version         Int
  envelopeVersion Int                         @default(1)
  algorithm       String                      @default("aes-256-gcm")
  ciphertext      String
  iv              String
  authTag         String
  keyVersion      Int
  fingerprint     String
  activeFrom      DateTime                    @default(now())
  retiredAt       DateTime?
  createdAt       DateTime                    @default(now())
  org             Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription    CustomerWebhookSubscription @relation(fields: [orgId, subscriptionId], references: [orgId, id], onDelete: Restrict)
  deliveries      CustomerWebhookDelivery[]

  @@unique([orgId, id])
  @@unique([orgId, subscriptionId, id])
  @@unique([orgId, subscriptionId, version])
  @@index([orgId])
  @@index([subscriptionId])
}

model CustomerWebhookEvent {
  id               String                    @id @default(cuid())
  orgId            String
  deduplicationKey String
  type             String
  schemaVersion    Int                       @default(1)
  aggregateType    String
  aggregateId      String?
  payloadText      String
  payloadHash      String
  occurredAt       DateTime
  createdAt        DateTime                  @default(now())
  org              Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries       CustomerWebhookDelivery[]

  @@unique([orgId, id])
  @@unique([orgId, deduplicationKey])
  @@index([orgId])
  @@index([orgId, type, occurredAt])
  @@index([orgId, aggregateType, aggregateId])
}

model CustomerWebhookDelivery {
  id                  String                           @id @default(cuid())
  orgId               String
  endpointId          String
  subscriptionId      String
  eventId             String
  signingSecretId     String
  status              CustomerWebhookDeliveryStatus    @default(PENDING)
  attemptCount        Int                              @default(0)
  maxAttempts         Int                              @default(8)
  nextAttemptAt       DateTime                         @default(now())
  processingToken     String?
  processingExpiresAt DateTime?
  generation          Int                              @default(1)
  replayOfDeliveryId  String?
  deliveredAt         DateTime?
  failedAt            DateTime?
  lastStatusCode      Int?
  lastErrorCode       String?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  org                 Organization                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription        CustomerWebhookSubscription      @relation(fields: [orgId, endpointId, subscriptionId], references: [orgId, endpointId, id], onDelete: Restrict)
  event               CustomerWebhookEvent             @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Restrict)
  signingSecret       CustomerWebhookSigningSecret     @relation(fields: [orgId, subscriptionId, signingSecretId], references: [orgId, subscriptionId, id], onDelete: Restrict)
  replayOf            CustomerWebhookDelivery?         @relation("CustomerWebhookDeliveryReplay", fields: [orgId, endpointId, eventId, replayOfDeliveryId], references: [orgId, endpointId, eventId, id], onDelete: Restrict)
  replays             CustomerWebhookDelivery[]        @relation("CustomerWebhookDeliveryReplay")
  attempts            CustomerWebhookDeliveryAttempt[]

  @@unique([orgId, id])
  @@unique([orgId, id, generation])
  @@unique([orgId, endpointId, eventId, id])
  @@unique([orgId, endpointId, eventId, generation])
  @@index([orgId])
  @@index([orgId, status, nextAttemptAt, processingExpiresAt])
  @@index([orgId, replayOfDeliveryId])
  @@index([eventId])
  @@index([signingSecretId])
  @@index([subscriptionId])
}

model CustomerWebhookDeliveryAttempt {
  id               String                  @id @default(cuid())
  orgId            String
  deliveryId       String
  generation       Int
  attemptNumber    Int
  requestTimestamp DateTime
  statusCode       Int?
  outcome          String?
  errorCode        String?
  startedAt        DateTime
  finishedAt       DateTime?
  createdAt        DateTime                @default(now())
  org              Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  delivery         CustomerWebhookDelivery @relation(fields: [orgId, deliveryId, generation], references: [orgId, id, generation], onDelete: Restrict)

  @@unique([orgId, id])
  @@unique([orgId, deliveryId, generation, attemptNumber])
  @@index([orgId])
  @@index([orgId, deliveryId, createdAt])
  @@index([deliveryId])
}
