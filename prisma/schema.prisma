generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

enum AuthThrottleScope {
  LOGIN_EMAIL
  LOGIN_NETWORK
  SETUP_NETWORK
  RESET_EMAIL
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
  PENDING_DOUBLE_OPT_IN
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PAUSED
  COMPLETED
}

enum ContactImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  BLOCKED
}

enum QueueJobType {
  SCHEDULED_CAMPAIGN
}

enum QueueJobStatus {
  QUEUED
  PROCESSING
  CANCELLED
  COMPLETED
  FAILED
}

enum A2pRegistrationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum UsageEventType {
  CONTACT_IMPORTED
  MESSAGE_INBOUND
  CAMPAIGN_SCHEDULED
  AI_REQUEST
}

enum BillingAccountStatus {
  DEMO
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ProviderPhoneNumberStatus {
  DEMO
  CONFIGURED
  DISABLED
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  clerkOrgId    String?        @unique
  demoMode      Boolean        @default(true)
  timezone      String         @default("America/Los_Angeles")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  contacts      Contact[]
  tags          Tag[]
  contactLists  ContactList[]
  segments      Segment[]
  contactImports ContactImport[]
  templates     MessageTemplate[]
  campaigns     Campaign[]
  queueJobs     QueueJob[]
  conversations Conversation[]
  messages      Message[]
  internalNotes InternalNote[]
  complianceProfile ComplianceProfile?
  usageEvents   UsageEvent[]
  billingAccount BillingAccount?
  webhookEvents WebhookEvent[]
  providerPhoneNumbers ProviderPhoneNumber[]
  providerCredentials ProviderCredential[]
  providerCredentialRotations ProviderCredentialRotation[]
  liveReadinessAuditEvents LiveReadinessAuditEvent[]
  authSessions  AuthSession[]
  authTokens    AuthToken[]
}

model AppUser {
  id              String       @id @default(cuid())
  /// Legacy optional external identity subject. Built-in users do not require Clerk.
  clerkUserId     String?      @unique
  email           String       @unique
  normalizedEmail String       @unique
  displayName     String?
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  authVersion     Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  internalNotes InternalNote[]
  localCredential LocalCredential?
  authSessions AuthSession[]
  authTokens AuthToken[] @relation("AuthTokenSubject")
  issuedAuthTokens AuthToken[] @relation("AuthTokenIssuer")

  @@index([disabledAt])
}

model LocalCredential {
  id                String   @id @default(cuid())
  userId            String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  failedAttempts    Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
}

model AuthSession {
  id                String        @id @default(cuid())
  tokenHash         String        @unique
  userId            String
  orgId             String
  authVersion       Int
  createdAt         DateTime      @default(now())
  lastSeenAt        DateTime      @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  user              AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  org               Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([orgId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model AuthToken {
  id             String          @id @default(cuid())
  type           AuthTokenType
  tokenHash      String          @unique
  userId         String?
  orgId          String?
  email          String?
  role           MembershipRole?
  issuedByUserId String?
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())
  user           AppUser?        @relation("AuthTokenSubject", fields: [userId], references: [id], onDelete: Cascade)
  org            Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  issuedBy       AppUser?        @relation("AuthTokenIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@index([type, expiresAt])
  @@index([userId, type])
  @@index([orgId, type])
  @@index([issuedByUserId])
}

model AuthThrottle {
  id              String            @id @default(cuid())
  scope           AuthThrottleScope
  keyHash         String
  windowStartedAt DateTime          @default(now())
  attempts        Int               @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime          @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
}

model Membership {
  id        String         @id @default(cuid())
  orgId     String
  userId    String
  role      MembershipRole @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model Contact {
  id            String        @id @default(cuid())
  orgId         String
  phone         String
  email         String?
  firstName     String?
  lastName      String?
  displayName   String?
  consentStatus ConsentStatus @default(UNKNOWN)
  optInSource   String?
  optInAt       DateTime?
  optedOutAt    DateTime?
  /// Part of the all-or-none, write-once consent evidence bundle enforced by database migrations.
  consentCapturedAt DateTime?
  /// Part of the all-or-none, write-once consent evidence bundle enforced by database migrations.
  consentMethod String?
  /// Part of the all-or-none, write-once consent evidence bundle enforced by database migrations.
  consentDisclosure String?
  source        String?
  notes         String?
  leadScore     Int?
  leadStage     String?
  leadQualifiedAt DateTime?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tagLinks      ContactTag[]
  listLinks     ContactListMember[]
  campaignRecipients CampaignRecipient[]
  conversations Conversation[]
  messages      Message[]

  @@unique([orgId, phone])
  @@index([orgId])
  @@index([orgId, consentStatus])
  @@index([orgId, archivedAt])
}

model Tag {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  color     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([orgId, name])
  @@index([orgId])
}

model ContactTag {
  id        String   @id @default(cuid())
  orgId     String
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([orgId])
  @@index([tagId])
}

model ContactList {
  id          String              @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     ContactListMember[]

  @@unique([orgId, name])
  @@index([orgId])
}

model ContactListMember {
  id        String      @id @default(cuid())
  orgId     String
  listId    String
  contactId String
  createdAt DateTime    @default(now())
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([orgId])
  @@index([contactId])
}

model Segment {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  description String?
  definition  Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

model MessageTemplate {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  body        String
  variables   Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@unique([orgId, name])
  @@index([orgId])
}

model ContactImport {
  id           String              @id @default(cuid())
  orgId        String
  filename     String?
  status       ContactImportStatus @default(PENDING)
  totalRows    Int                 @default(0)
  importedRows Int                 @default(0)
  failedRows   Int                 @default(0)
  errors       Json?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Campaign {
  id          String         @id @default(cuid())
  orgId       String
  templateId  String?
  name        String
  status      CampaignStatus @default(DRAFT)
  body        String
  scheduledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template    MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients  CampaignRecipient[]
  queueJobs   QueueJob[]
  messages    Message[]

  @@index([orgId])
  @@index([orgId, status])
}

model CampaignRecipient {
  id          String                  @id @default(cuid())
  orgId       String
  campaignId  String
  contactId   String
  status      CampaignRecipientStatus @default(PENDING)
  blockReason String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  campaign    Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([orgId])
  @@index([contactId])
}

model Conversation {
  id               String             @id @default(cuid())
  orgId            String
  contactId        String?
  assignedToUserId String?
  status           ConversationStatus @default(OPEN)
  lastMessageAt    DateTime?
  assignedAt       DateTime?
  resolvedAt       DateTime?
  sentiment        String?
  category         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact          Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo       AppUser?           @relation("ConversationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages         Message[]
  internalNotes    InternalNote[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([contactId])
  @@index([assignedToUserId])
}

model QueueJob {
  id             String         @id @default(cuid())
  orgId          String
  campaignId     String?
  type           QueueJobType
  status         QueueJobStatus @default(QUEUED)
  idempotencyKey String
  payload        Json
  runAt          DateTime
  processingToken String?
  processingExpiresAt DateTime?
  /// Monotonic durable generation used to distinguish reopened BullMQ mirror jobs.
  generation     Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([orgId, status])
  @@index([status, processingExpiresAt])
  @@index([campaignId])
}

model Message {
  id                  String        @id @default(cuid())
  orgId               String
  contactId           String?
  conversationId      String?
  campaignId          String?
  direction           String
  body                String
  providerMessageId   String?
  providerStatus      String?
  providerErrorCode   String?
  deliveredAt         DateTime?
  failedAt            DateTime?
  idempotencyKey      String
  createdAt           DateTime      @default(now())
  org                 Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact             Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  campaign            Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([conversationId])
  @@index([contactId])
  @@index([providerMessageId])
}

model InternalNote {
  id             String       @id @default(cuid())
  orgId          String
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         AppUser      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([conversationId])
  @@index([authorUserId])
}

model ComplianceProfile {
  id                 String                @id @default(cuid())
  orgId              String                @unique
  businessName       String?
  messagingUseCase   String?
  optInDescription   String?
  privacyPolicyUrl   String?
  termsOfServiceUrl  String?
  a2pRegistrationStatus A2pRegistrationStatus @default(NOT_STARTED)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  org                Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model UsageEvent {
  id        String         @id @default(cuid())
  orgId     String
  type      UsageEventType
  quantity  Int            @default(1)
  metadata  Json?
  createdAt DateTime       @default(now())
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, type])
  @@index([createdAt])
}

model BillingAccount {
  id                  String               @id @default(cuid())
  orgId               String               @unique
  status              BillingAccountStatus @default(DEMO)
  liveBillingEnabled  Boolean              @default(false)
  stripeCustomerId    String?
  stripeSubscriptionId String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  org                 Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
}

model ProviderPhoneNumber {
  id           String                    @id @default(cuid())
  orgId        String
  phoneNumber  String
  label        String?
  provider     String                    @default("dummy")
  status       ProviderPhoneNumberStatus @default(DEMO)
  capabilities Json
  /// At most one true row per org; enforced by a partial unique index in migration SQL.
  isDefault    Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  org          Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, phoneNumber])
  @@index([orgId])
  @@index([orgId, isDefault])
  @@index([orgId, provider])
}

model ProviderCredential {
  id                    String       @id @default(cuid())
  orgId                 String
  provider              String
  accountSidRedacted    String?
  accountSidLast4       String?
  authTokenFingerprint  String?
  authTokenConfigured   Boolean      @default(false)
  fromNumberRedacted    String?
  fromNumberLast4       String?
  source                String       @default("local_metadata")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@index([orgId])
  @@index([orgId, provider])
}

model ProviderCredentialRotation {
  id                       String       @id @default(cuid())
  orgId                    String
  provider                 String
  providerCredentialId     String?
  action                   String
  actorUserId              String?
  accountSidRedacted       String?
  accountSidLast4          String?
  fromNumberRedacted       String?
  fromNumberLast4          String?
  authTokenConfigured      Boolean      @default(false)
  previousAccountSidLast4  String?
  previousFromNumberLast4  String?
  previousAuthTokenConfigured Boolean   @default(false)
  source                   String       @default("local_metadata")
  createdAt                DateTime     @default(now())
  org                      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, provider])
  @@index([createdAt])
}

model LiveReadinessAuditEvent {
  id           String       @id @default(cuid())
  orgId        String
  actorUserId  String?
  action       String
  subjectType  String
  subjectId    String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, action])
  @@index([createdAt])
}

model WebhookEvent {
  id             String       @id @default(cuid())
  orgId          String
  provider       String
  eventType      String
  idempotencyKey String
  rawPayload     Json
  receivedAt     DateTime     @default(now())
  processedAt    DateTime?
  claimToken     String?
  claimExpiresAt DateTime?
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([orgId, provider, eventType])
  @@index([orgId, processedAt, claimExpiresAt])
  @@index([receivedAt])
}
