# Runtime profile. Fresh installs remain demo-safe and web-only.
APP_ENV=local
RUNTIME_PROCESS=web
DEMO_MODE=true
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WEB_HOST="0.0.0.0"
WEB_PORT=3000
# Keep false for demo/dev. Production local auth requires a trusted ingress that strips and rewrites
# X-Forwarded-For, X-Forwarded-Host, and X-Forwarded-Proto before setting this to true.
TRUST_PROXY=false

# PostgreSQL is authoritative. Redis/BullMQ remains optional.
DATABASE_URL="postgresql://signalstack:signalstack@localhost:5432/signalstack_sms?schema=public"
# Owner credential for `npm run db:deploy` only. Never expose this to a running web/worker process.
# MIGRATION_DATABASE_URL="postgresql://signalstack_owner:replace-me@localhost:5432/signalstack_sms?schema=public"
DATABASE_RLS_ENFORCED=false
QUEUE_BACKEND=database
REDIS_URL=""

# Worker defaults do not start or authorize production/live execution.
WORKER_ENABLED=false
WORKER_DEPLOYMENT_CLASS=local-demo
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000

# Messaging provider. Demo mode requires dummy and live messaging disabled.
MESSAGING_PROVIDER=dummy
LIVE_MESSAGING_ENABLED=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# Built-in local auth is the standalone default. Generate secrets outside source control.
AUTH_PROVIDER=local
# Dedicated HMAC key for opaque session lookup hashes; use at least 32 characters.
AUTH_SESSION_SECRET=""
# Dedicated HMAC key for auth throttles; use 32-256 characters and do not reuse another secret.
AUTH_THROTTLE_SECRET=""
# Provision only for first-owner setup, then remove or rotate it.
BOOTSTRAP_TOKEN=""
# Must be at least 10 minutes; session last-seen refreshes are bounded to five-minute intervals.
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=24
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# One-shot, noninteractive local administrator creation. Never set a password value here.
# admin:create requires DEMO_MODE=false, AUTH_PROVIDER=local, and the explicit DATABASE_URL above.
ADMIN_CREATE_MODE=""
ADMIN_CREATE_EMAIL=""
ADMIN_CREATE_DISPLAY_NAME=""
ADMIN_CREATE_ORG_NAME=""
ADMIN_CREATE_ORG_SLUG=""
ADMIN_CREATE_TIMEZONE=""
ADMIN_CREATE_PASSWORD_FILE=""
ADMIN_CREATE_PASSWORD_STDIN=false

# One-shot operator password recovery. The command prints one fragment bearer; never persist it here.
ADMIN_RESET_EMAIL=""
ADMIN_RESET_ORG_SLUG=""
ADMIN_RESET_EXPIRES_MINUTES="60"

# 256-bit master key: 64 hex characters or base64-encoded 32 bytes.
SECRETS_MASTER_KEY=""
API_KEY_PEPPER=""

# Data lifecycle defaults. Zero disables retention for the eligible non-audit categories.
MESSAGE_BODY_RETENTION_DAYS=365
MEDIA_RETENTION_DAYS=90
RAW_WEBHOOK_RETENTION_DAYS=30
API_LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=2555
RETENTION_CLEANUP_INTERVAL_HOURS=24

# Backups are disabled until an encryption key is provisioned.
BACKUP_ENABLED=false
BACKUP_DIRECTORY="./backups"
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=""
BACKUP_OFFSITE_URL=""
BACKUP_REQUIRE_OFFSITE=false

# Existing isolated live-test and paid-lookup controls.
LIVE_TEST_SMS_ENABLED=false
LIVE_TEST_SMS_TO_ALLOWLIST=""
LIVE_TEST_SMS_OPERATOR_TOKEN=""
LIVE_TEST_SMS_TIMEOUT_MS=5000
LIVE_LOOKUP_ENABLED=false
LIVE_LOOKUP_COST_ACK=false
LIVE_LOOKUP_OPERATOR_TOKEN=""
LIVE_LOOKUP_TIMEOUT_MS=3000

# Optional AI, billing, observability, rate-limit, and legacy auth seams.
AI_PROVIDER=fake
LIVE_AI_ENABLED=false
AI_COST_ACK=false
AI_API_KEY=""
AI_DRAFT_DAILY_CAP=100
LIVE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
OBSERVABILITY_ENABLED=false
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
PRODUCTION_AUTH_ENABLED=false
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
